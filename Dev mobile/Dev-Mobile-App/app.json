{
  "expo": {
    "name": "Dev-Mobile-App",
    "slug": "Dev-Mobile-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFDFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anonymous.Dev-Mobile-App"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFDFF"
      },
      "package": "com.anonymous.DevMobileApp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
